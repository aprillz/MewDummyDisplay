<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>Aprillz.MewDummyDisplay</AssemblyName>
    <RootNamespace>Aprillz.MewDummyDisplay</RootNamespace>
    <PackageId>Aprillz.MewDummyDisplay</PackageId>
    <Description>macOS virtual dummy display management library</Description>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Aprillz.MewDummyDisplay.Tests" />
  </ItemGroup>

  <!-- Generic Objective-C runtime access, linked rather than referenced so the App can
       use the same helpers without the library exposing them or gaining a UI dependency. -->
  <ItemGroup>
    <Compile Include="../Shared/ObjCRuntime/**/*.cs" LinkBase="Interop" />
  </ItemGroup>

</Project>
