<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <PropertyGroup>
    <Company>Aprillz</Company>
    <Authors>Aprillz</Authors>
    <Copyright>Copyright (c) 2026 Aprillz</Copyright>
    <Product>MewDummyDisplay</Product>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <!-- MewUI repository location. Only the App project uses it; the library and CLI never reference MewUI. -->
  <PropertyGroup>
    <MewUIRepoPath Condition="'$(MewUIRepoPath)' == ''">$(MSBuildThisFileDirectory)../../MewUI</MewUIRepoPath>
  </PropertyGroup>

</Project>
