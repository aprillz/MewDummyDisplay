# macOS
.DS_Store

# Build output. Bundles land under .artifacts, which is already ignored; a bare
# "*.app/" pattern must not be used because git is case-insensitive here and it
# would also swallow the MewDummyDisplay.App project directory.
*.dmg

# Working material kept local: design notes, the reference snapshot, and the
# one-off diagnostic scripts that belong to an investigation rather than the build.
/agent/
/reference/
/tools/
